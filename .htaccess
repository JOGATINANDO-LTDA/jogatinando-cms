RewriteEngine On

# Upload limits (Apache mod_php only)
<IfModule mod_php.c>
    php_value post_max_size 110M
    php_value upload_max_filesize 100M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
# CGI/FastCGI fallback (shared hosting)
<IfModule mod_fcgid.c>
    FcgidMaxRequestLen 115343360
</IfModule>

# Game player: /{engine}/{slug} → game.php?engine=$1&slug=$2
RewriteRule ^([a-zA-Z0-9-]+)/([a-zA-Z0-9-]+)$ game.php?engine=$1&slug=$2 [L,QSA]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]

# Game player: /{engine}/{slug} → game.php?engine=$1&slug=$2
RewriteRule ^([a-zA-Z0-9-]+)/([a-zA-Z0-9-]+)$ game.php?engine=$1&slug=$2 [L,QSA]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
